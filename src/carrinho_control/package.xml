<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>carrinho_control</name>
  <version>0.1.0</version>
  <description>
    Camada de controle (PID) do carrinho autônomo: fecha a malha de
    velocidade linear (motor + wheel_odom) e de direção/yaw (servo + IMU),
    publicando /cmd_vel_pid a partir de /cmd_vel.
  </description>
  <maintainer email="voce@exemplo.com">seu_nome</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>

  <!-- não é dependência de build/runtime do node em si, só do launch,
       que sobe os outros pacotes junto -->
  <exec_depend>servo_steering</exec_depend>
  <exec_depend>carrinho_localization</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
